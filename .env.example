# Copiá este archivo como .env y cambiá los valores. El archivo .env NO se sube al repositorio.
# Todos los valores de abajo son de ejemplo para desarrollo local.

ENTORNO=desarrollo

# Base de datos local (docker compose usa estas variables)
POSTGRES_PASSWORD=cambiar_esto_local_migrador
APP_DB_PASSWORD=cambiar_esto_local_app

# Conexión del rol que corre las migraciones (dueño de las tablas)
DATABASE_URL_MIGRADOR=postgresql+psycopg://ks_migrador:cambiar_esto_local_migrador@localhost:5432/ks
# Conexión del rol que usa la aplicación (sin permiso para modificar ni borrar la auditoría)
DATABASE_URL_APP=postgresql+psycopg://ks_app:cambiar_esto_local_app@localhost:5432/ks

# Firma de los tokens de sesión: generá uno largo y aleatorio (mínimo 32 caracteres), por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=elembajadorpiriririririririririr
# Duración de la sesión en horas (una jornada de trabajo)
JWT_HORAS=8

# Direcciones desde las que se permite usar la API (separadas por coma)
CORS_ORIGINS=http://localhost:5173

# Dirección de la API que usa el frontend al compilarse
VITE_API_URL=http://localhost:8000
